# Copy this file to .env and enter values for your environment.
# Never commit the completed .env file.
# Default: local MariaDB + local disk, without AWS or OAuth credentials.
# For academy server deployment, use deploy/server.env.example instead.

# MariaDB installed directly on each developer's PC.
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3307
LOCAL_DB_DATABASE=cakeshop
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=test1234

# Optional legacy AWS RDS connection (rds profile only).
RDS_ENDPOINT=your-rds-endpoint
RDS_PORT=3306
RDS_DATABASE=your-rds-database
RDS_USERNAME=your-rds-username
RDS_PASSWORD=your-rds-password

# Local directory (outside the project): where uploaded images are stored.
# If unset, defaults to <user home>/cakeshop-uploads.
# Example Windows path: C:/cakeshop-uploads
# FILE_UPLOAD_DIR=/absolute/path/to/cakeshop-uploads

# Payment gateway selection. Default: toss.
# Initial gateway of a new payment; customers can switch on the payment page.
# own = DonWorry. Requires DONWORRY_PAYMENT_ENABLED=true, otherwise startup stops.
PAYMENT_GATEWAY=toss

# Toss Payments test or live keys. Use a matching client/secret key pair.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_CONNECT_TIMEOUT=3s
TOSS_READ_TIMEOUT=5s

# Reserved; not used. The own gateway (DonWorry) uses the DONWORRY_* settings below.
OWN_PG_BASE_URL=
OWN_PG_API_KEY=
OWN_PG_CONNECT_TIMEOUT=3s
OWN_PG_READ_TIMEOUT=5s

# DonWorry payment API client. Disabled by default.
# When enabled, customers can choose DonWorry on the payment page (PAYMENT_GATEWAY is only the initial choice).
# Local DonWorry: http://localhost:8081
# The HMAC key DONWORRY_MERCHANT_HMAC_CAKESHOP is NOT read from this file.
# Set it as an OS environment variable with the same value as DonWorry (see DonWorry docs/demo/local-demo.md 2-1).
DONWORRY_PAYMENT_ENABLED=false
DONWORRY_PAYMENT_BASE_URL=

PAYMENT_RECOVERY_FIXED_DELAY=60s
PAYMENT_RECOVERY_INITIAL_DELAY=60s
PAYMENT_RECOVERY_BATCH_SIZE=50

# S3 file storage. Use only with the s3 Spring profile.
# Leave credentials blank in this sample. Enter them only in the ignored local .env,
# or use the AWS SDK default credential provider chain such as an IAM role.
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_BUCKET=sweethan-cakeshop-images
AWS_S3_BASE_URL=https://sweethan-cakeshop-images.s3.ap-northeast-2.amazonaws.com
AWS_S3_KEY_PREFIX=local-your-githubId

# Gmail SMTP for member email verification. Use an app password, not the account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-project-email@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=your-project-email@gmail.com
MAIL_FROM_NAME=SweetHan

# Google/Kakao OAuth login. Enable the oauth Spring profile after entering all values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# KAKAO_CLIENT_ID is the REST API key from Kakao Developers.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
