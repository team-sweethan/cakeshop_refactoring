# .env로 복사한다. 이 파일은 Spring properties 형식이며 shell에서 source하지 않는다.
# 실행할 JAR과 .env가 있는 디렉터리에서 java 명령을 실행한다.
SPRING_PROFILES_ACTIVE=server
SERVER_PORT=8080

# 학원에서 배정받은 MariaDB 접속 정보. 비밀번호는 반드시 실제 값으로 교체한다.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cakeshop
DB_USERNAME=cakeshop
DB_PASSWORD=replace-with-server-db-password

# 공용 DB 자동 변경 방지. 빈 전용 DB의 최초 구축 시에만 true로 변경한다.
SERVER_FLYWAY_ENABLED=false

# 실행 계정이 쓰기 가능한 영구 절대 경로. 서버 OS에 맞게 변경한다.
FILE_UPLOAD_DIR=/srv/cakeshop/uploads

# 이메일 인증/결제 사용 시 입력한다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SweetHan
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 돈워리(자체 PG) 결제창·웹훅 연동 (DonWorry ADR-0064 6절). 쓰지 않으면 DONWORRY_PAYMENT_ENABLED=false로 둔다.
# 새 결제의 초기 PG. 고객은 결제 화면에서 토스·돈워리를 고를 수 있다(pg-decisions 006).
# own으로 두려면 DONWORRY_PAYMENT_ENABLED=true여야 한다(아니면 앱 시작이 중단된다).
PAYMENT_GATEWAY=toss
DONWORRY_PAYMENT_ENABLED=false
# 돈워리 API 주소(서버에서 닿는 주소)
DONWORRY_PAYMENT_BASE_URL=
# 이 쇼핑몰의 공개 주소. 결제창 복귀 주소와 웹훅 수신 주소({이 값}/webhooks/donworry)의 앞부분이다.
# 운영에서는 https여야 한다(돈워리가 https · 공인 주소로만 웹훅을 보낸다).
DONWORRY_PAYMENT_SHOP_BASE_URL=
# 돈워리 화면(사람이 보는 웹) 공개 주소. API 주소(DONWORRY_PAYMENT_BASE_URL)와 다르다.
# 관리자 "결제 확인 중" 안내의 "돈워리에서 확인하기" 링크가 {이 값}/owner/actions(돈워리 오너 보안 조치 결과)로 간다.
# 비워 두면 링크를 숨긴다. 예: https://donworry.shinhanacademy.ac.kr (끝에 / 없이)
DONWORRY_CONSOLE_BASE_URL=
# 가맹점 서명 키 DONWORRY_MERCHANT_HMAC_CAKESHOP은 이 파일에 넣지 않는다.
# 돈워리와 같은 값을 실행 계정의 OS 환경 변수로 둔다(System.getenv로 읽는다).

# 소셜 로그인을 사용할 때만 server,oauth로 변경하고 네 값을 모두 입력한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
